meta {
  name: Write a review
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Organization-Id: {{org_uuid}}
}

body:json {
  {
    "spot_uuid": "{{spot_uuid}}",
    "rating": 5,
    "body": "Worth the walk. Go before noon."
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("review_uuid", res.getBody().data.uuid);
  }
}

assert {
  res.status: eq 201
  res.body.data.rating: eq 5
}

docs {
  One review per explorer per spot — a second attempt is a 422, not a duplicate.
  Writing a review recomputes the spot's `rating_average` and `reviews_count`.
}
