meta {
  name: Create post
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Organization-Id: {{org_uuid}}
}

body:json {
  {
    "spot_uuid": "{{spot_uuid}}",
    "caption": "Golden hour did not disappoint.",
    "visibility": "public",
    "publish": true
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("post_uuid", res.getBody().data.uuid);
  }
}

assert {
  res.status: eq 201
  res.body.data.is_published: eq true
}

docs {
  A post about the spot. `publish: true` publishes immediately; omit it to
  create the post now and publish later (the offline flow — the record exists
  before its photos finish uploading). `published_at` is always the server
  clock, never the client's.
}
