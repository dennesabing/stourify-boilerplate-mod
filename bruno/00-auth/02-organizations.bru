meta {
  name: My organizations
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/mobile/auth/organizations
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().data.length > 0) {
    // Stourify content all belongs to the single public organization; the
    // client resolves its UUID here rather than hardcoding it.
    bru.setEnvVar("org_uuid", res.getBody().data[0].uuid);
  }
}

assert {
  res.status: eq 200
  res.body.data[0].uuid: isDefined
}

docs {
  Resolves the organization UUID the client sends on every request as
  `X-Organization-Id`. Stores the first one in `org_uuid`. In production this is
  the single `Stourify Public` organization.
}
